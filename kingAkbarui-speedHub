                })
                Custom:Create("UICorner", { CornerRadius = UDim.new(1, 0) }, Bar)

                local Fill = Custom:Create("Frame", {
                    BackgroundColor3 = Speed_Library.Theme.Accent,
                    Size = UDim2.new(math.clamp((Def - Min) / (Max - Min), 0, 1), 0, 1, 0),
                    Parent = Bar
                })
                Custom:Create("UICorner", { CornerRadius = UDim.new(1, 0) }, Fill)

                local function UpdateSlider(input)
                    local percent = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
                    local calculated = math.floor((Min + (Max - Min) * percent) / Inc + 0.5) * Inc
                    SliderFunc:Set(calculated)
                end

                function SliderFunc:Set(val)
                    val = math.clamp(val, Min, Max)
                    SliderFunc.Value = val
                    Speed_Library.Flags[SFlag] = val
                    ValLabel.Text = tostring(val)
                    Fill.Size = UDim2.new(math.clamp((val - Min) / (Max - Min), 0, 1), 0, 1, 0)
                    pcall(SCallback, val)
                end

                local dragging = false
                Bar.InputBegan:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        UpdateSlider(inp)
                    end
                end)

                UserInputService.InputEnded:Connect(function(inp)
                    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(inp)
                    if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                        UpdateSlider(inp)
                    end
                end)

                Speed_Library.Elements[SFlag] = SliderFunc
                ItemCount += 1
                return SliderFunc
            end

            -- Paragraph
            function Items:AddParagraph(Config)
                local PTitle = Config.Title or Config[1] or ""
                local PContent = Config.Content or Config[2] or ""

                local PFrame = Custom:Create("Frame", {
                    BackgroundColor3 = Speed_Library.Theme.Background,
                    Size = UDim2.new(1, 0, 0, 48),
                    LayoutOrder = ItemCount,
                    Parent = SecContent
                })
                Custom:Create("UICorner", { CornerRadius = UDim.new(0, 4) }, PFrame)

                Custom:Create("TextLabel", {
                    Text = PTitle,
                    Font = Speed_Library.Theme.FontBold,
                    TextColor3 = Speed_Library.Theme.TextColor,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 6),
                    Size = UDim2.new(1, -16, 0, 14),
                    Parent = PFrame
                })

                Custom:Create("TextLabel", {
                    Text = PContent,
                    Font = Speed_Library.Theme.FontRegular,
                    TextColor3 = Speed_Library.Theme.TextSubColor,
                    TextSize = 11,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 8, 0, 22),
                    Size = UDim2.new(1, -16, 1, -26),
                    Parent = PFrame
                })

                ItemCount += 1
            end

            ItemCount += 1
            return Items
        end

        TabCount += 1
        return Sections
    end

    return Tabs
end

return Speed_Library
