--[[
  CONTOH AUTO-SAVE (wrapper FuncsV3)
  - Nilai dengan Default = "Save" otomatis dimuat dari config & disimpan saat berubah.
  - Kunci simpanan = NAMA item → pakai nama yang unik.
  - Config disimpan ke file JSON di folder workspace executor.
]]

local KA = loadstring(game:HttpGet("https://raw.githubusercontent.com/Akbar025zzz/kingAkbarUi-Speedhub/refs/heads/main/loader.lua"))()
local Library, FuncsV3 = KA.Library, KA.Wrapper

local HttpService = game:GetService("HttpService")
local FILE = "KingAkbar_Config.json"

-- 1) muat config lama (jika ada)
local Config = {}
if isfile and isfile(FILE) then
  pcall(function() Config = HttpService:JSONDecode(readfile(FILE)) end)
end

-- 2) fungsi simpan dipanggil wrapper (sudah di-debounce 0.5 detik)
FuncsV3:SetTable(Config, function(cfg)
  if writefile then writefile(FILE, HttpService:JSONEncode(cfg)) end
end)

-- 3) UI
local Window  = Library:CreateWindow({ Title = "King Akbar", Description = "Auto-Save" })
local Tab     = Window:CreateTab({ "Main" })
local Section = Tab:AddSection("Farming", true)

FuncsV3:Toggle(Section, "Auto Farm", "Dimuat dari config", "Save", function(v)
  print("Auto Farm:", v)
end)

FuncsV3:Slider(Section, "WalkSpeed", "Min 16 – Max 200", 16, 200, "Save", function(v)
  print("WalkSpeed:", v)
end, 1) -- argumen terakhir = Increment (opsional)

FuncsV3:Dropdown(Section, "Mode", "Pilih mode", false, { "Safe", "Fast", "Insane" }, "Save", function(v)
  print("Mode:", v[1])
end)

FuncsV3:Textbox(Section, "Target", "Nama target", "Save", function(v)
  print("Target:", v)
end)

FuncsV3:Button(Section, "Reset Config", "Hapus file config lalu tutup UI", function()
  if delfile and isfile and isfile(FILE) then delfile(FILE) end
  Library:SetNotification({ "Config", "•", "Config dihapus. Jalankan ulang script.", nil, 0.4, 4 })
  Window:Destroy()
end)
